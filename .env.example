# Docker Compose only. Use a long, unique local password.
POSTGRES_PASSWORD=change-me-before-running

# Use :80 only for a server without TLS. Use your real domain in production;
# Caddy then provisions and renews HTTPS certificates automatically.
CADDY_SITE_ADDRESS=:80

# Keep this aligned with the public dashboard origin when browser access is needed.
REPODOCTOR_CORS_ORIGINS=http://localhost
