{$CADDY_SITE_ADDRESS} {
    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }

    # The dashboard can expose repository paths and findings. Keep both the UI
    # and API behind authentication when the stack is reachable from the Internet.
    basic_auth {
        {$CADDY_BASIC_AUTH_USER} {$CADDY_BASIC_AUTH_HASH}
    }

    @api path /api/*
    handle @api {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy web:3000
    }
}
